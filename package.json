{
  "name": "loom",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A tiny runtime reactive UI core.",
  "license": "MIT",
  "author": "Janos Veres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jveres/loom.git"
  },
  "sideEffects": [
    "./dist/loom/defer.js",
    "./dist/loom/observe*.js",
    "./src/core/defer.ts",
    "./src/core/inspect.ts",
    "./src/observe.ts"
  ],
  "files": [
    "dist/loom",
    "dist/types",
    "src",
    "docs",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --execArgv=--expose-gc",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "bench": "vitest bench --run",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --config vite.loom.config.ts && rm -rf dist/types && tsc -p tsconfig.build.json",
    "build:demo": "vite build --outDir dist/demo",
    "size": "pnpm run build && node scripts/size.mjs",
    "samples": "node scripts/samples.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/loom/loom.js"
    },
    "./model": {
      "types": "./dist/types/model.d.ts",
      "default": "./dist/loom/model.js"
    },
    "./dom": {
      "types": "./dist/types/dom/index.d.ts",
      "default": "./dist/loom/dom.js"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "default": "./dist/loom/browser.js"
    },
    "./events": {
      "types": "./dist/types/events.d.ts",
      "default": "./dist/loom/events.js"
    },
    "./layout": {
      "types": "./dist/types/layout.d.ts",
      "default": "./dist/loom/layout.js"
    },
    "./motion": {
      "types": "./dist/types/motion.d.ts",
      "default": "./dist/loom/motion.js"
    },
    "./schedule": {
      "types": "./dist/types/schedule.d.ts",
      "default": "./dist/loom/schedule.js"
    },
    "./storage": {
      "types": "./dist/types/storage.d.ts",
      "default": "./dist/loom/storage.js"
    },
    "./virtual-list": {
      "types": "./dist/types/dom/virtual-list.d.ts",
      "default": "./dist/loom/virtual-list.js"
    },
    "./async": {
      "types": "./dist/types/async/index.d.ts",
      "default": "./dist/loom/async.js"
    },
    "./defer": {
      "types": "./dist/types/core/defer.d.ts",
      "default": "./dist/loom/defer.js"
    },
    "./observe": {
      "types": "./dist/types/observe.d.ts",
      "default": "./dist/loom/observe.js"
    },
    "./devtools": {
      "types": "./dist/types/devtools/index.d.ts",
      "default": "./dist/loom/devtools.js"
    },
    "./html": {
      "types": "./dist/types/html/index.d.ts",
      "default": "./dist/loom/html.js"
    },
    "./jsx-runtime": {
      "types": "./dist/types/dom/jsx-runtime.d.ts",
      "default": "./dist/loom/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/types/dom/jsx-runtime.d.ts",
      "default": "./dist/loom/jsx-runtime.js"
    },
    "./html/jsx-runtime": {
      "types": "./dist/types/html/jsx-runtime.d.ts",
      "default": "./dist/loom/html/jsx-runtime.js"
    },
    "./html/jsx-dev-runtime": {
      "types": "./dist/types/html/jsx-runtime.d.ts",
      "default": "./dist/loom/html/jsx-runtime.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.2.0",
    "alien-signals": "3.2.1",
    "idiomorph": "^0.7.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "playwright": "1.62.1"
  }
}
